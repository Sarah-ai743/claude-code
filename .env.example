# ---------------------------------------------------------------------------
# LeadPilot AI — example environment file
#
#   1. Copy this file to `.env.local` for local development.
#   2. In production (Vercel), paste these same keys into the project's
#      Environment Variables settings instead of uploading a file.
#   3. Never commit a real `.env` / `.env.local` file — it's git-ignored.
# ---------------------------------------------------------------------------

# --- Supabase ----------------------------------------------------------
# From your Supabase project's Settings -> API page.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — SECRET. Server-only. Never expose to the browser or
# prefix with NEXT_PUBLIC_. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic Claude ----------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-5

# --- Cron ------------------------------------------------------------------
# Shared secret the follow-up cron job must present. Generate with:
#     openssl rand -hex 32
# Vercel Cron automatically sends this as `Authorization: Bearer <value>`
# when CRON_SECRET is set as a project environment variable.
CRON_SECRET=replace-me-run-openssl-rand-hex-32

# --- App ---------------------------------------------------------------
# Public base URL of the deployed app (used in email redirect links, the
# public contact-form link on the Integrations page, etc).
NEXT_PUBLIC_APP_URL=http://localhost:3000
