# ---------------------------------------------------------------------------
# LeadPilot API — example environment file
#
# HOW THIS WORKS
#   1. Copy this file to `.env`  ->  `cp .env.example .env`
#   2. Fill in real values in `.env` (which is git-ignored and never committed)
#   3. In production you do NOT upload a .env file. You paste these same keys
#      into your hosting provider's "Environment Variables" dashboard.
#
# RULE: this file contains NAMES and FAKE values only. Never a real secret.
#
# Variables marked [PHASE 1+] are not read by any code yet — they are here so
# the full picture is in one place. Only the unmarked ones matter today.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
NODE_ENV=development            # development | test | production
PORT=8080
API_BASE_URL=http://localhost:8080
LOG_LEVEL=debug                 # debug | info | warn | error

# --- Database [PHASE 1+] ---------------------------------------------------
# Postgres connection string from Neon / Supabase / Railway / RDS.
DATABASE_URL=postgresql://user:password@localhost:5432/leadpilot

# --- API access token (required in production) ------------------------------
# The shared secret a caller must present to use the API:
#     Authorization: Bearer <token>
#
# Generate a real one — never invent one by hand:
#     openssl rand -hex 32
#
# Several tokens can be listed, comma-separated, so you can rotate without
# downtime: add the new one, move callers across, then remove the old one.
# The server refuses to start if this is left as the placeholder below.
LEADPILOT_API_TOKEN=replace-me-run-openssl-rand-hex-32

# --- Per-user authentication [PHASE 1+] -------------------------------------
# We verify tokens issued by an identity provider (Clerk, Supabase Auth, Auth0).
# JWKS_URL is the provider's public key list — used to check token signatures.
AUTH_JWKS_URL=https://your-tenant.example.com/.well-known/jwks.json
AUTH_ISSUER=https://your-tenant.example.com/
AUTH_AUDIENCE=leadpilot-api

# Secret used to sign our own short-lived internal tokens (generate a long
# random string: `openssl rand -base64 48`).
JWT_SECRET=replace-me-with-a-long-random-string

# --- Machine-to-machine access [PHASE 1+] ----------------------------------
# Salt/pepper used when hashing API keys before storing them in the database.
API_KEY_HASH_SECRET=replace-me-with-a-long-random-string

# --- Frontend / CORS -------------------------------------------------------
# Comma-separated list of origins allowed to call this API from a browser.
# Add your Base44 app's published domain here. "*" is never allowed in prod.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-app.base44.app

# --- AI provider -----------------------------------------------------------
# `mock` runs the whole API offline with no key and no cost — used by the tests.
AI_PROVIDER=anthropic           # anthropic | mock
AI_MODEL_DEFAULT=claude-opus-5
AI_EFFORT=medium                # low | medium | high — how hard the model thinks
AI_TIMEOUT_MS=60000             # give up on a single AI call after this long
AI_MAX_RETRIES=2                # SDK-level retries on transient failures
AI_MAX_OUTPUT_TOKENS=2000       # ceiling on one response — a cost guard

# Required only when AI_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# --- Rate limiting [PHASE 1+] ----------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
REDIS_URL=                      # optional; enables shared rate limits + job queue

# --- Email (phase 5) -------------------------------------------------------
EMAIL_PROVIDER=resend           # resend | postmark | sendgrid | ses
EMAIL_API_KEY=
EMAIL_FROM=hello@yourdomain.com

# --- Calendar (phase 6) ----------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/v1/integrations/google/callback

# --- CRM (phase 6) ---------------------------------------------------------
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# --- Webhooks [PHASE 6] ----------------------------------------------------
# Used to sign webhooks we SEND, and to verify webhooks we RECEIVE.
WEBHOOK_SIGNING_SECRET=replace-me-with-a-long-random-string

# --- Encryption [PHASE 1+] -------------------------------------------------
# 32-byte base64 key used to encrypt third-party OAuth tokens at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-me-with-a-32-byte-base64-key
